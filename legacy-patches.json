  "patches": [
    "BrowserRouter /testnet basename",
    "fixed isolated Testnet RPC proxy",
    "no saved-consent auto-connect",
    "prefixed raw navigation links",
    "allowlisted case-correct asset paths",
    "network selector and named startup/retry",
    "hide unavailable quote ticker instead of showing zero prices",
    "replace incompatible synthetic chart with unavailable history",
    "keep network selector above legacy fixed navigation",
    "replace fabricated holder rows with unavailable state",
    "label static protocol details without implying an audit",
    "disable legacy wallet context/signing/raw submission pending verified integration",
    "bounded read-only transport without settled-response cache",
    "validate listing identity and metadata; distinguish unavailable listings",
    "correct creator/protocol fee and legacy curve estimate labels",
    "remove invented creator activity and stale detail commits",
    "safe public image URLs; suppress external quotes without freshness proof",
    "replace listing-derived pseudo transaction events with explicit activity unavailable state"
  ],
